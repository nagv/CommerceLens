# Local demonstration only. The default values match Compose.
LOCAL_DB_PASSWORD=local-demo-only
LOCAL_BROKER_PASSWORD=local-demo-only

# Chat and embeddings (Nebius; alternatively set CHAT_* / EMBEDDING_* explicitly)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_CHAT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Must match actual embedding dimensions; current Nebius model returns 4096.
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX=commercelens-docs
PINECONE_NAMESPACE=commercelens-docs-v1
# Tracing/upload require explicit CLI flags.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=commercelens-documentation-assistant
