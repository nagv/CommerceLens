        }
      ]
    },
    {
      "id": "claim_84ef7006fe924f469d2800e5703ce1ad",
      "statement": "Any other non-success HTTP response from the provider is mapped to HTTP 502 with status \"unknown\", meaning the caller cannot assume the shipment was not created.",
      "evidence": [
        {
