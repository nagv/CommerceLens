  "claims": [
    {
      "id": "claim_54147ca67b024a5886a78d1e300430a1",
      "statement": "The ShippingProvider HttpClient base address is configured from the SHIPPING_PROVIDER_URL environment variable with a default of http://mock-provider:8080, and the timeout is configured from PROVIDER_TIMEOUT_SECONDS with a default of 3 seconds.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L6-L9",
          "version": "repo-lines-v1:sha256:fafe6a6b128b4883432147bad124bf049d57635641a32d7f11b962007c2e3b62:"
        }
      ]
    },
    {
      "id": "claim_60b83045f24544f39f01240904881cc2",
      "statement": "The outbound shipment creation request is a POST to /shipments and includes an Idempotency-Key HTTP header whose value is the request orderId.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L29-L30",
          "version": "repo-lines-v1:sha256:cd98ab2b952d6e4179645f729c4b5241e0a45e1ed475fbdd37f2cce2ca53d590:"
        }
      ]
    },
    {
      "id": "claim_2ec26c892114484fbadcdaafdac6d23b",
      "statement": "The incoming request body on POST /api/shipments is validated for non-empty orderId and postalCode fields with maximum lengths of 128 and 32 respectively, and scenario must be \"success\" or \"failure\".",
      "evidence": [
        {
          "resource": "repo://Program.cs#L13-L15",
          "version": "repo-lines-v1:sha256:2e12556d4e862f256961f0a86f09e2f8377d956d8633d1011d85dc8161764161:"
        }
      ]
    },
    {
      "id": "claim_fc279be92bd04e01996833ba5ad66437",
      "statement": "The provider must return a response with status \"created\", non-empty shipmentId, non-empty trackingNumber, and shippingCents equal to 500; any deviation causes a ProviderException mapped to 502 with status \"unknown\".",
      "evidence": [
        {
          "resource": "repo://Program.cs#L38-L40",
          "version": "repo-lines-v1:sha256:0fcf9c1066d7ed3a415e2ebd80dced96c601ee5c40c215eb59cb32e2c5650540:"
        }
      ]
    },
    {
      "id": "claim_1e690e449c8b4c4dbf467a1e1e2c5fb3",
      "statement": "OperationCanceledException is caught in the local endpoint handler and mapped to HTTP 504 with status \"unknown\", indicating the shipment outcome is ambiguous and the caller must reconcile.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L17-L17",
          "version": "repo-lines-v1:sha256:f6cfd8b2935a1f5783628eee6cc7087b052f7257ea579549b24f83b17312e878:"
        }
      ]
    },
    {
      "id": "claim_27ae69ba26524a06bb6287a4ee79fa96",
      "statement": "HttpRequestException is caught and mapped to HTTP 502 with status \"unknown\", indicating the shipping provider is unavailable and the shipment outcome is ambiguous.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L19-L19",
          "version": "repo-lines-v1:sha256:884d5902cbd2173a4463fa562eb8df374d9236771e8c3391416dee05f0bcd8bf:"
        }
      ]
    },
    {
      "id": "claim_786fc874749c45b9adf23dfda20b5175",
      "statement": "JsonException due to an invalid provider response body is caught and mapped to HTTP 502 with status \"unknown\", indicating the shipment outcome is ambiguous.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L20-L20",
          "version": "repo-lines-v1:sha256:a7ba59e0e63d5fba69fe788d9b718b5ac504d4d0531608bf2ca026a80b0c93cc:"
        }
      ]
    },
    {
      "id": "claim_f48a91d1e023422885add0d53fe772eb",
      "statement": "A provider HTTP 422 UnprocessableEntity response is mapped to HTTP 422 with status \"failed\", which is the only outcome safe for callers to compensate because it proves no shipment was created.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L18-L18",
          "version": "repo-lines-v1:sha256:745d4e0752a3559ecdcad789a501af6d05a4d4b7b91143a6f7f312c35870ee7f:"
        },
        {
