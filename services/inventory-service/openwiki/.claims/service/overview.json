    {
      "id": "claim_e389204ccd06440689fce6d38da79fa8",
      "statement": "The CommerceLens Inventory Service is a single-binary Go HTTP service that owns authoritative product prices and stock reservations. Its purpose is to manage inventory_products and inventory_reservations tables, providing product catalog listings, stock reservations, and releases to upstream callers such as a checkout service.",
