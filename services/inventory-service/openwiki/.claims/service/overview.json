    {
      "id": "claim_050f3f3971284015b18a90da0194644b",
      "statement": "Stock overselling is prevented by selecting inventory_products rows with FOR UPDATE in ascending SKU order within the reservation transaction. Concurrent requests for the same order_id are serialized by a pg_advisory_xact_lock via hashtextextended(orderId, 0).",
