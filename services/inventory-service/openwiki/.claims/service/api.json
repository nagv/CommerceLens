    {
      "id": "claim_bdb44765b7a1446ca06656357c7f0dce",
      "statement": "Store.handler() registers four HTTP endpoints in main.go: GET /health for database readiness, GET /api/products to return a JSON array of products, POST /api/reservations to reserve stock, and POST /api/reservations/{orderId}/release to idempotently release reserved stock.",
      "evidence": [
        {
          "resource": "repo://main.go#L202-L252",
          "version": "repo-lines-v1:sha256:46b99e8d1606c8b13f8f1566ccec6e77191c69df0276f882159e01079b9ebbf5:"
        }
      ]
    },
    {
      "id": "claim_580a0acb8c6348a1b95f4609d5d1eb7e",
      "statement": "GET /health checks database readiness by calling pool.Ping with a 2-second request timeout and returns 200 with {\"status\":\"ok\"} on success, or 503 on failure.",
      "evidence": [
        {
          "resource": "repo://main.go#L204-L212",
          "version": "repo-lines-v1:sha256:83f34e7b6a365a0348591c9750710da2f217396839f8ab92a7fa97b5e224bf99:"
