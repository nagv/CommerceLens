        }
      ]
    },
    {
      "id": "claim_a3b75528e2f74fcfa54a08b3d3017f8d",
      "statement": "If an existing reservation row for the same orderId has a matching request_hash and status 'reserved', reserve() replays the cached body JSON, commits, and returns the stored result without modifying inventory.",
