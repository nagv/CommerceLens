    {
      "id": "claim_b9ff7ca8529844aa8f6bd82406cdaa3e",
      "statement": "After successful stock decrement, reserve() inserts a new row into inventory_reservations with order_id, request_hash, the marshaled result body, and status 'reserved', then commits the transaction.",
