    {
      "id": "claim_d0df173d2c5246cc9ddbb685963c82d1",
      "statement": "The POST /api/reservations HTTP handler enforces a 64 KiB body limit with MaxBytesReader, rejects unknown JSON fields with DisallowUnknownFields, and requires a single JSON object via an EOF guard on a second decode.",
      "evidence": [
        {
          "resource": "repo://main.go#L221-L233",
          "version": "repo-lines-v1:sha256:769882aff69d7be059073ee15b8a99485e8a51c20ad70889e41c3189287160a7:"
        }
      ]
    },
    {
      "id": "claim_8dae1ef4e4af4894a5b85809f533f923",
      "statement": "validate() returns a 400 APIError when orderId is empty or longer than 100 characters, when there are 0 or more than 100 items, when SKUs are not distinct, when a SKU is empty or longer than 100 characters, or when quantity is outside 1-1000.",
      "evidence": [
        {
          "resource": "repo://main.go#L54-L66",
          "version": "repo-lines-v1:sha256:673dabdbc2e97654a12435b4a53f46e60180d241bc4d35a7fb91cde84c8e1f8d:"
        }
      ]
    },
    {
