    {
      "id": "claim_216fe5187170473ea411f03fe82105e6",
      "statement": "When a duplicate idempotency key is submitted with a different canonical hash, OrderController returns 409 Conflict with a message indicating the key was already used for a different request and includes the existing order id.",
