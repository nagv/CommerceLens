        }
      ]
    },
    {
      "id": "claim_34e17665d2484dfa9b88e9c0246d4991",
      "statement": "OrderStoreTest.postgresAcceptsOnlyOneConcurrentIdempotencyKey races eight threads submitting twenty concurrent inserts with the same idempotency key against a real PostgreSQL database and asserts exactly one succeeds. The test is skipped unless TEST_JDBC_URL, TEST_DB_USER, and TEST_DB_PASSWORD are configured.",
