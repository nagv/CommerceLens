  "claims": [
    {
      "id": "claim_01f269071f4d4a8d8fe7d9591f1ce37e",
      "statement": "The orders table has columns: id (TEXT PRIMARY KEY), idempotency_key (TEXT UNIQUE NOT NULL), request_hash (TEXT NOT NULL), body (JSONB NOT NULL), http_status (INTEGER NOT NULL DEFAULT 409), and created_at (TIMESTAMPTZ NOT NULL DEFAULT now()).",
      "evidence": [
        {
          "resource": "repo://src/main/resources/schema.sql#L1-L8",
          "version": "repo-lines-v1:sha256:aedd1acdd178c1e05c680c02da5c99072a97748587e90f94233a61d614ce78e3:"
        }
      ]
    },
    {
      "id": "claim_0e747a7cf3734d388014641adf86278a",
      "statement": "The order_outbox table has columns: event_id (TEXT PRIMARY KEY), payload (JSONB NOT NULL), created_at (TIMESTAMPTZ NOT NULL DEFAULT now()), published_at (TIMESTAMPTZ), attempts (INTEGER NOT NULL DEFAULT 0), and last_error (TEXT). It stores events until OutboxPublisher confirms delivery to RabbitMQ.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/schema.sql#L9-L16",
          "version": "repo-lines-v1:sha256:a85a8d67540290361bf32434522e7f95ae75ff26e5362fb49fc31884da422975:"
        }
      ]
    },
    {
      "id": "claim_b2d9b364d69a45feb55da41bb62a8689",
      "statement": "The idempotency_key column has a database-level UNIQUE constraint in the orders table. OrderStore.create uses INSERT with ON CONFLICT(idempotency_key) DO NOTHING so that only one concurrent insert succeeds for the same key, and OrderStoreTest verifies exactly one success out of 20 concurrent attempts across 8 threads.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/commercelens/orders/OrderStore.java#L15-L15",
          "version": "repo-lines-v1:sha256:ca99475c065f4c4c3ee48d3b71cd9c58497cc242ead912cd62a1dba8cc7f9809:"
        },
        {
          "resource": "repo://src/test/java/com/commercelens/orders/OrderStoreTest.java#L15-L24",
          "version": "repo-lines-v1:sha256:06121182621c8d668e1ec11f9f80744d0d0d62bf7bbe46213ace68c1d6cb5023:"
        }
      ]
    },
    {
      "id": "claim_d5db61aa1c4e4aeca9ff6e6bb4b5304d",
      "statement": "OrderStore uses a Jackson ObjectMapper for JSONB encoding and decoding. The httpStatus field on Checkout.Order is annotated with @JsonIgnore, so it is not serialized into the body column; instead it is stored in a separate http_status column and re-injected on read by the decode method.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/commercelens/orders/Checkout.java#L16-L16",
          "version": "repo-lines-v1:sha256:1c3b04e1d01aff3441e3fe5088c0402acfc4cde272aae3aa5d83c403eda28fa1:"
        },
        {
