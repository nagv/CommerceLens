          "version": "repo-lines-v1:sha256:cf19ea29ad6996cbd8a4aac2630d2f2c197edfbc45a434887bf7a8a9d493d7e0:"
        }
      ]
    },
    {
      "id": "claim_fad1af79e7de42eb9bbb2dafb9cd783d",
      "statement": "OrderStore.create inserts a new order row with id, idempotency_key, request_hash, and body as JSONB, returning true if a row was inserted and false if the idempotency key already existed.",
