    {
      "id": "claim_cbd35e7c9fbf41f4856e4f8388d0c962",
      "statement": "OrderStore.finish is annotated with @Transactional. It updates the order body JSONB and http_status columns, and if the order status is confirmed, it inserts an event into order_outbox with a deterministic event_id and JSONB payload, using ON CONFLICT DO NOTHING for idempotency.",
