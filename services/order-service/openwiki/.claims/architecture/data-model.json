    {
      "id": "claim_9372c46851384f809aa6e48b0ea0e5f2",
      "statement": "OutboxPublisher polls order_outbox every 2 seconds, selects up to 10 unpublished rows with FOR UPDATE SKIP LOCKED, sends each to the RabbitMQ order.confirmed queue, and updates published_at only after receiving a broker ACK, enabling at-least-once delivery where consumers deduplicate by eventId.",
