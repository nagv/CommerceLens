    {
      "id": "claim_32e405a7086040b6b7ec1210bcf7cb03",
      "statement": "POST /api/orders requires an Idempotency-Key header matching ^[A-Za-z0-9_-]{1,100}$. It enforces idempotency by SHA-256 hashing a canonical request body (items sorted by SKU, default scenarios normalized). Reusing the key with identical input returns the stored outcome without external calls; different input returns 409. In-progress requests return 409 with latest persisted state.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/commercelens/orders/OrderController.java#L18-L25",
          "version": "repo-lines-v1:sha256:c38ef75d02e06ea7917c7fc14f08b6a1be63069899e6e10aa3177470e0bfdcac:"
        },
        {
          "resource": "repo://src/main/java/com/commercelens/orders/OrderStore.java#L15-L17",
          "version": "repo-lines-v1:sha256:0d5bf7ab21b9b6cad01e03a7818f50069579534b113722b3687fc8a9dbf5e00d:"
        }
      ]
    },
    {
      "id": "claim_e466eac1ad9448c9ad880c863d9040f2",
      "statement": "The service publishes durable RabbitMQ messages to the queue order.confirmed on the default exchange, configured with x-dead-letter-routing-key order.confirmed.dead. Publisher confirms (correlated) and mandatory returns are enabled. The dead queue order.confirmed.dead is also durable.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/commercelens/orders/OutboxPublisher.java#L19-L20",
          "version": "repo-lines-v1:sha256:12520fd45ab37a54451a353a55e35e4f80e5e9529d554f280c252bb8f7585de7:"
        },
        {
