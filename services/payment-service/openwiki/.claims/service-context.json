      "statement": "The service maps provider 402 to 402 {message: 'Payment declined', status: 'declined'}; provider 409 to 409 {message: 'Conflicting provider idempotency key', status: 'unknown'}; non-success responses to 502 {message: 'Payment provider unavailable; reconcile before retrying', status: 'unknown'}; and httpx.TimeoutException to 504 {message: 'Payment provider timed out; outcome requires reconciliation', status: 'unknown'}.",
      "evidence": [
        {
          "resource": "repo://app.py#L31-L48",
          "version": "repo-lines-v1:sha256:e82e0591d833917c636168909ae88d1f5a7384b90a6032649bab0eb6f13a5ed3:"
