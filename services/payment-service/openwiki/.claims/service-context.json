    },
    {
      "id": "claim_8fad78dc422841a08d94485f153360ae",
      "statement": "The forward() function validates the provider response: for /payments it requires a dict with status 'authorized' and a paymentId; for /refunds it requires status 'refunded'. Invalid responses return 502.",
      "evidence": [
        {
          "resource": "repo://app.py#L31-L48",
